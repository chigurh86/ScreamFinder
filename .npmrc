legacy-peer-deps=true
node-linker=hoisted
public-hoist-pattern[]=*babel-plugin*
public-hoist-pattern[]=*babel-preset*
public-hoist-pattern[]=*hermes-parser*
public-hoist-pattern[]=@babel/*
shamefully-hoist=true
# EAS Build defaults pnpm to --frozen-lockfile in CI. Our lockfile
# drifts from package.json (91 packages listed in the lockfile that
# are not declared in package.json, plus 18 version mismatches),
# so frozen mode fails the Install dependencies phase. Turning it
# off lets pnpm resolve strictly against package.json and update
# the lockfile in-place on the build VM.
frozen-lockfile=false
