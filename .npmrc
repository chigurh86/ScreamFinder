legacy-peer-deps=true
node-linker=hoisted
public-hoist-pattern[]=*babel-plugin*
public-hoist-pattern[]=*babel-preset*
public-hoist-pattern[]=*hermes-parser*
public-hoist-pattern[]=@babel/*
shamefully-hoist=true
# EAS Build defaults pnpm to --frozen-lockfile in CI. Our lockfile
# drifts from package.json (91 packages listed in the lockfile that
# are not declared in package.json, plus 18 version mismatches),
# so frozen mode fails the Install dependencies phase. Turning it
# off lets pnpm resolve strictly against package.json and update
# the lockfile in-place on the build VM.
frozen-lockfile=false
# pnpm 10+ throws ERR_PNPM_IGNORED_BUILDS when transitive deps ship
# postinstall scripts that haven't been individually approved. Since
# none of the offending packages (protobufjs, react-native-elements,
# unrs-resolver, plus any other transitive scripts) need their post-
# install hooks at runtime -- expo-modules-autolinking wires native
# modules during `expo prebuild` / CocoaPods, not via a Node post-
# install -- we globally disable script execution. This flag is
# honored by both pnpm and npm, so the same behavior applies on the
# EAS Build VM regardless of which package manager EAS picks.
ignore-scripts=true
# Same idea, spelled the pnpm 10.4+ way, in case ignore-scripts alone
# does not silence the strict-dep-builds check.
strict-dep-builds=false
dangerously-allow-all-builds=true
