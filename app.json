{
  "expo": {
    "name": "ScreamFinder",
    "slug": "screamfinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-store-icon.png",
    "scheme": "screamfinder",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fa.screamfinder",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ScreamFinder needs access to your photo library to set a profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fa.screamfinder",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-store-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-store-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/spooky-eyes.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
